    {
      "name": "Fraqueza Variável",
      "type": "poder",
      "system": {
        "description": {
          "value": "<p style=\"text-align:justify\"><span class=\"fontstyle2\">O Rhandomm é suscetível a um tipo de dano, que muda sempre que ele desperta de sua hibernação. Para determinar esse tipo de dano, role 1d10 e consulte a tabela a seguir. Efeitos que causem esse tipo de dano ignoram a imunidade a dano do Rhandomm.</span></p><table><tbody><tr><td data-colwidth=\"60\"><p style=\"text-align:center\"><strong>1</strong></p></td><td data-colwidth=\"124\"><p style=\"text-align:center\"><span class=\"fontstyle2\"><strong>Ácido</strong></span></p></td></tr><tr><td data-colwidth=\"60\"><p style=\"text-align:center\"><strong>2</strong></p></td><td data-colwidth=\"124\"><p style=\"text-align:center\"><strong>Corte</strong></p></td></tr><tr><td data-colwidth=\"60\"><p style=\"text-align:center\"><strong>3</strong></p></td><td data-colwidth=\"124\"><p style=\"text-align:center\"><strong>Eletricidade</strong></p></td></tr><tr><td data-colwidth=\"60\"><p style=\"text-align:center\"><strong>4</strong></p></td><td data-colwidth=\"124\"><p style=\"text-align:center\"><strong>Essência</strong></p></td></tr><tr><td data-colwidth=\"60\"><p style=\"text-align:center\"><strong>5</strong></p></td><td data-colwidth=\"124\"><p style=\"text-align:center\"><strong>Fogo</strong></p></td></tr><tr><td data-colwidth=\"60\"><p style=\"text-align:center\"><strong>6</strong></p></td><td data-colwidth=\"124\"><p style=\"text-align:center\"><strong>Frio</strong></p></td></tr><tr><td data-colwidth=\"60\"><p style=\"text-align:center\"><strong>7</strong></p></td><td data-colwidth=\"124\"><p style=\"text-align:center\"><strong>Impacto</strong></p></td></tr><tr><td data-colwidth=\"60\"><p style=\"text-align:center\"><strong>8</strong></p></td><td data-colwidth=\"124\"><p style=\"text-align:center\"><strong>Luz</strong></p></td></tr><tr><td data-colwidth=\"60\"><p style=\"text-align:center\"><strong>9</strong></p></td><td data-colwidth=\"124\"><p style=\"text-align:center\"><strong>Perfuração</strong></p></td></tr><tr><td data-colwidth=\"60\"><p style=\"text-align:center\"><strong>10</strong></p></td><td data-colwidth=\"124\"><p style=\"text-align:center\"><strong>Trevas</strong></p></td></tr></tbody></table><p style=\"text-align:justify\"><br style=\"font-style:normal;font-variant:normal;font-weight:normal;letter-spacing:normal;line-height:normal;orphans:2;text-align:-webkit-auto;text-indent:0px;text-transform:none;white-space:normal;widows:2;word-spacing:0px;-webkit-text-size-adjust:auto;-webkit-text-stroke-width:0px\" /></p>",
