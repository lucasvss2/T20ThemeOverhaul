  "items": [
    {
      "type": "poder",
      "name": "Cicatrizes Amordaçantes",
      "img": "icons/magic/unholy/beams-impact-pink.webp",
      "system": {
        "description": {
          "value": "<p style=\"text-align:justify\"><span class=\"fontstyle0\">Por mais que tente, o purificado não consegue alertar outras pessoas de sua condição. Qualquer tentativa do purificado de fazer isso requer que o interlocutor passe em um teste de Intuição (CD 25). Se falhar, ele não entende o que o purificado tentou comunicar durante a rodada.</span> <br style=\"font-style:normal;font-variant:normal;font-weight:normal;letter-spacing:normal;line-height:normal;orphans:2;text-align:-webkit-auto;text-indent:0px;text-transform:none;white-space:normal;widows:2;word-spacing:0px;-webkit-text-size-adjust:auto;-webkit-text-stroke-width:0px\" /></p>",
