    {
      "folder": null,
      "name": "Dente de Wisphago",
      "type": "equipamento",
      "img": "icons/commodities/bones/horn-simple-tan.webp",
      "system": {
        "description": {
          "value": "<p style=\"text-align:justify\"><span class=\"fontstyle2\">Um dente de wisphago pode ser vestido como um amuleto. Quando faz um teste de resistência contra uma magia arcana, você pode gastar o amuleto para rolar novamente esse teste com um bônus de +2. Uma vez ativado, o amuleto se desfaz. Um dente de wisphago não pode ser fabricado.</span></p><p style=\"text-align:justify\"></p>",
          "unidentified": ""
