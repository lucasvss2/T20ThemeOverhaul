      "name": "Engolir",
      "type": "poder",
      "img": "icons/creatures/abilities/dragon-breath-purple.webp",
      "system": {
        "description": {
          "value": "<p style=\"text-align:justify\"><span class=\"fontstyle0\">No início de cada um dos turnos do kaiju, cada criatura engolida sofre 2d20+50 pontos de dano de impacto mais 2d20+50 pontos de dano de ácido. Elas podem escapar causando um total de 200 pontos de dano a ele (Defesa 25, fortificação 25%, redução de dano 0). O kaiju pode manter uma criatura Enorme, ou até dez criaturas Grandes ou menores, engolidas por vez.</span> </p>",
          "unidentified": ""
        },
