      "name": "Reabastecer",
      "type": "poder",
      "system": {
        "description": {
          "value": "<p style=\"text-align:justify\"><span class=\"fontstyle2\">Se estiver em contato com um corpo d’água Médio ou maior, o elemental recebe cura acelerada 50. Além disso, se fosse sofrer dano mágico de frio, em vez disso ele cura PV em quantidade igual à metade do dano que sofreria.</span> <br style=\"font-style:normal;font-variant:normal;font-weight:normal;letter-spacing:normal;line-height:normal;orphans:2;text-align:-webkit-auto;text-indent:0px;text-transform:none;white-space:normal;widows:2;word-spacing:0px;-webkit-text-size-adjust:auto;-webkit-text-stroke-width:0px\" /></p>",
